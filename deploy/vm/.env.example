# Copy to .env (never commit it) and fill in.

# Hostname pointing at this VM (A record). Caddy gets HTTPS for it.
# No domain? Use <your-ip-with-dashes>.sslip.io, e.g. 129-146-1-2.sslip.io
DOMAIN=api.example.com

# Your Vercel URL, no trailing slash. Used for CORS and the post-login redirect.
FRONTEND_URL=https://algobattle.vercel.app

# Shared by the API and the auth service. Generate with: openssl rand -hex 32
SECRET_KEY=

# GitHub > Settings > Developer settings > OAuth Apps > New OAuth App
#   Homepage URL:               your FRONTEND_URL
#   Authorization callback URL: https://<DOMAIN>/auth/login/oauth2/code/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub usernames that become ADMIN on login (comma-separated).
ADMIN_GITHUB_LOGINS=

# Optional: enables the AI interviewer and problem generator (paid per call).
OPENAI_API_KEY=
AI_INTERVIEW_LIMIT_PER_HOUR=40
AI_GENERATE_LIMIT_PER_HOUR=10
