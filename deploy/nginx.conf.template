# Rendered at container start by the nginx image's entrypoint, which runs
# envsubst over /etc/nginx/templates/*.template. It only substitutes names that
# are actually set in the environment, so nginx's own $host / $http_upgrade
# variables pass through untouched — only ${BACKEND_HOST} is replaced.

# WebSocket upgrades need Connection: upgrade when the client asks for it and
# Connection: close otherwise; a hardcoded "upgrade" breaks plain HTTP requests.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream backend {
    server ${BACKEND_HOST}:8000;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Hashed asset filenames are immutable; index.html must never be cached or
    # clients keep booting the previous deploy's bundle.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Every API route sits under one prefix, so this is the only backend rule
    # that has to exist — and the only one to keep in sync when routes change.
    location /api/ {
        proxy_pass http://backend;
        proxy_http_version 1.1;

        # Battle rooms, matchmaking, and tournaments are all WebSockets.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # A benchmark compiles and runs a submission at six input sizes, which
        # comfortably outlasts the 60s default.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location /health {
        proxy_pass http://backend;
        access_log off;
    }

    # SPA: unknown paths are client-side routes, not 404s.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
